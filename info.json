{
  "id": "plugin.com.dean-op.llm_ocr",
  "plugin_type": "recognize",
  "icon": "icon.svg",
  "display": "LLM OCR",
  "homepage": "https://github.com/Dean-op/pot-app-recognize-plugin-llm",
  "needs": [
    {
      "key": "base_url",
      "display": "Base URL",
      "type": "select",
      "options": {
        "https://api.siliconflow.cn/v1": "SiliconFlow",
        "https://api.openai.com/v1": "OpenAI",
        "https://openrouter.ai/api/v1": "OpenRouter",
        "https://dashscope.aliyuncs.com/compatible-mode/v1": "Alibaba Cloud Bailian",
        "https://api.moonshot.cn/v1": "Moonshot AI",
        "https://api.deepseek.com/v1": "DeepSeek",
        "http://localhost:1234/v1": "LM Studio (Local)",
        "http://localhost:11434/v1": "Ollama (Local)",
        "__custom__": "Custom"
      }
    },
    {
      "key": "custom_base_url",
      "display": "Custom Base URL",
      "type": "input"
    },
    {
      "key": "apiKey",
      "display": "API Key",
      "type": "input"
    },
    {
      "key": "model",
      "display": "Model",
      "type": "input"
    }
  ],
  "language": {
    "auto": "auto",
    "zh_cn": "Chinese",
    "zh_tw": "Traditional Chinese",
    "en": "English",
    "ja": "Japanese",
    "ko": "Korean",
    "fr": "French",
    "de": "German",
    "es": "Spanish"
  }
}
